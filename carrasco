#!/bin/bash

# ══════════════════════════════════════════════════════════════
#   DARKZSAID VPS MANAGER - INSTALADOR PRINCIPAL
# ══════════════════════════════════════════════════════════════

set -o pipefail

RESET="\e[0m"
BOLD="\e[1m"
R="\e[31m"
G="\e[32m"
Y="\e[33m"
C="\e[36m"
W="\e[37m"

LINEA="${C}══════════════════════════════════════════════════════════════${RESET}"

APP_NAME="DarkZsaid VPS Manager"
APP_DIR="/opt/darkzsaid"
BOT_DIR="$APP_DIR/bot"
LOG_FILE="/var/log/darkzsaid-install.log"
SERVICE_NAME="darkzsaid-bot"

# CAMBIA ESTE REPO POR EL REPOSITORIO REAL DE TU BOT
BOT_REPO="https://github.com/stevenjosecarcamo-star/BOT-TELEGRAM-VPN.git"

GO_VERSION="1.22.5"
GO_TAR="go${GO_VERSION}.linux-amd64.tar.gz"
GO_URL="https://go.dev/dl/${GO_TAR}"

titulo() {
    clear
    echo -e "$LINEA"
    echo -e "${C}${BOLD}        ⚔️ DARKZSAID VPS MANAGER ⚔️${RESET}"
    echo -e "$LINEA"
    echo ""
    echo -e "${W}${BOLD}$1${RESET}"
    echo ""
}

ok() {
    echo -e "${G}✔${RESET} $1"
}

info() {
    echo -e "${C}[INFO]${RESET} $1"
}

warn() {
    echo -e "${Y}[AVISO]${RESET} $1"
}

error() {
    echo -e "${R}[ERROR]${RESET} $1"
}

verificar_root() {
    if [[ "$EUID" -ne 0 ]]; then
        error "Debes ejecutar este instalador como root."
        exit 1
    fi

    ok "Permisos root confirmados"
}

detectar_sistema() {
    titulo "DETECTANDO SISTEMA"

    if [[ -f /etc/os-release ]]; then
        source /etc/os-release
        ok "Sistema detectado: $PRETTY_NAME"
    else
        error "No se pudo detectar el sistema operativo."
        exit 1
    fi
}

crear_directorios() {
    titulo "CREANDO ESTRUCTURA"

    mkdir -p "$APP_DIR"
    mkdir -p "$APP_DIR/bin"
    mkdir -p "$APP_DIR/config"
    mkdir -p "$APP_DIR/logs"
    mkdir -p "$APP_DIR/backups"

    touch "$LOG_FILE"

    ok "Directorio principal creado: $APP_DIR"
    ok "Carpetas internas preparadas"
}

instalar_dependencias() {
    titulo "INSTALANDO DEPENDENCIAS"

    apt-get update -y >> "$LOG_FILE" 2>&1

    apt-get install -y \
        curl \
        wget \
        git \
        unzip \
        nano \
        screen \
        net-tools \
        ca-certificates \
        gnupg \
        lsb-release \
        iptables \
        iproute2 \
        build-essential \
        software-properties-common \
        >> "$LOG_FILE" 2>&1

    if [[ "$?" -eq 0 ]]; then
        ok "Dependencias instaladas correctamente"
    else
        error "Falló la instalación de dependencias."
        echo "Revisa el log: $LOG_FILE"
        exit 1
    fi
}

instalar_go() {
    titulo "INSTALANDO GO"

    if command -v go >/dev/null 2>&1; then
        ok "Go ya está instalado: $(go version)"
        return
    fi

    cd /tmp || exit 1

    info "Descargando Go $GO_VERSION..."
    wget -q -O "$GO_TAR" "$GO_URL"

    if [[ ! -s "$GO_TAR" ]]; then
        error "No se pudo descargar Go."
        exit 1
    fi

    rm -rf /usr/local/go
    tar -C /usr/local -xzf "$GO_TAR"

    if ! grep -q "/usr/local/go/bin" /etc/profile; then
        echo 'export PATH=$PATH:/usr/local/go/bin' >> /etc/profile
    fi

    export PATH=$PATH:/usr/local/go/bin

    if command -v go >/dev/null 2>&1; then
        ok "Go instalado correctamente: $(go version)"
    else
        error "Go no quedó instalado correctamente."
        exit 1
    fi
}

clonar_bot() {
    titulo "DESCARGANDO BOT"

    if [[ -d "$BOT_DIR/.git" ]]; then
        info "El bot ya existe. Actualizando..."
        cd "$BOT_DIR" || exit 1
        git pull origin main >> "$LOG_FILE" 2>&1
    else
        rm -rf "$BOT_DIR"
        git clone "$BOT_REPO" "$BOT_DIR" >> "$LOG_FILE" 2>&1
    fi

    if [[ "$?" -eq 0 ]]; then
        ok "Código del bot descargado en: $BOT_DIR"
    else
        error "No se pudo clonar el repositorio del bot."
        echo ""
        echo "Revisa si el repo existe o si está privado:"
        echo "$BOT_REPO"
        echo ""
        echo "Log:"
        tail -n 20 "$LOG_FILE"
        exit 1
    fi
}

crear_env() {
    titulo "CREANDO CONFIGURACIÓN DEL BOT"

    ENV_FILE="$BOT_DIR/.env"

    if [[ -f "$ENV_FILE" ]]; then
        warn "El archivo .env ya existe. No se sobrescribirá."
        return
    fi

    cat > "$ENV_FILE" <<CONFIG
BOT_TOKEN=CAMBIA_ESTO_POR_TU_TOKEN
ADMIN_ID=CAMBIA_ESTO_POR_TU_ID
APP_NAME=DarkZsaid VPS Manager
APP_DIR=$APP_DIR
CONFIG

    ok "Archivo .env creado en: $ENV_FILE"
    warn "Recuerda editar BOT_TOKEN y ADMIN_ID antes de iniciar el bot."
}

compilar_bot() {
    titulo "COMPILANDO BOT"

    cd "$BOT_DIR" || exit 1

    export PATH=$PATH:/usr/local/go/bin

    if [[ -f "go.mod" ]]; then
        go mod tidy >> "$LOG_FILE" 2>&1
    else
        warn "No se encontró go.mod. Se intentará compilar igual."
    fi

    go build -o "$APP_DIR/bin/darkzsaid-bot" . >> "$LOG_FILE" 2>&1

    if [[ "$?" -eq 0 && -f "$APP_DIR/bin/darkzsaid-bot" ]]; then
        chmod +x "$APP_DIR/bin/darkzsaid-bot"
        ok "Bot compilado correctamente"
    else
        error "No se pudo compilar el bot."
        echo "Revisa el log:"
        tail -n 30 "$LOG_FILE"
        exit 1
    fi
}

crear_servicio() {
    titulo "CREANDO SERVICIO SYSTEMD"

    cat > "/etc/systemd/system/${SERVICE_NAME}.service" <<SERVICE
[Unit]
Description=DarkZsaid Telegram Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=$BOT_DIR
ExecStart=$APP_DIR/bin/darkzsaid-bot
Restart=always
RestartSec=5
EnvironmentFile=$BOT_DIR/.env

[Install]
WantedBy=multi-user.target
SERVICE

    systemctl daemon-reload
    systemctl enable "$SERVICE_NAME" >> "$LOG_FILE" 2>&1

    ok "Servicio creado: $SERVICE_NAME"
}

crear_comando_darkzsaid() {
    titulo "CREANDO COMANDO DARKZSAID"

    cat > /usr/local/bin/darkzsaid <<'MENU'
#!/bin/bash

SERVICE_NAME="darkzsaid-bot"
APP_DIR="/opt/darkzsaid"
BOT_DIR="$APP_DIR/bot"

while true; do
    clear
    echo "══════════════════════════════════════════════════════════════"
    echo "             ⚔️ DARKZSAID VPS MANAGER ⚔️"
    echo "══════════════════════════════════════════════════════════════"
    echo ""
    echo "1) Ver estado del bot"
    echo "2) Iniciar bot"
    echo "3) Detener bot"
    echo "4) Reiniciar bot"
    echo "5) Ver logs del bot"
    echo "6) Editar configuración .env"
    echo "7) Salir"
    echo ""
    read -p "Selecciona una opción: " op

    case "$op" in
        1)
            systemctl status "$SERVICE_NAME"
            read -p "Presiona ENTER para continuar..."
            ;;
        2)
            systemctl start "$SERVICE_NAME"
            echo "Bot iniciado."
            sleep 2
            ;;
        3)
            systemctl stop "$SERVICE_NAME"
            echo "Bot detenido."
            sleep 2
            ;;
        4)
            systemctl restart "$SERVICE_NAME"
            echo "Bot reiniciado."
            sleep 2
            ;;
        5)
            journalctl -u "$SERVICE_NAME" -f
            ;;
        6)
            nano "$BOT_DIR/.env"
            ;;
        7)
            exit 0
            ;;
        *)
            echo "Opción inválida."
            sleep 2
            ;;
    esac
done
MENU

    chmod +x /usr/local/bin/darkzsaid

    ok "Comando creado: darkzsaid"
}

mostrar_resumen() {
    titulo "RESUMEN FINAL"

    echo -e "${G}✔ Instalación base completada${RESET}"
    echo -e "${G}✔ Directorio principal:${RESET} $APP_DIR"
    echo -e "${G}✔ Código del bot:${RESET} $BOT_DIR"
    echo -e "${G}✔ Binario:${RESET} $APP_DIR/bin/darkzsaid-bot"
    echo -e "${G}✔ Servicio:${RESET} $SERVICE_NAME"
    echo ""
    echo -e "${Y}IMPORTANTE:${RESET}"
    echo "Edita el archivo .env antes de iniciar el bot:"
    echo ""
    echo "nano $BOT_DIR/.env"
    echo ""
    echo "Después inicia el bot con:"
    echo ""
    echo "systemctl start $SERVICE_NAME"
    echo ""
    echo "O abre el menú con:"
    echo ""
    echo "darkzsaid"
    echo ""
    echo -e "$LINEA"
    echo -e "${G}${BOLD}        INSTALADOR PRINCIPAL FINALIZADO${RESET}"
    echo -e "$LINEA"
    echo ""
}

main() {
    detectar_sistema
    verificar_root
    crear_directorios
    instalar_dependencias
    instalar_go
    clonar_bot
    crear_env
    compilar_bot
    crear_servicio
    crear_comando_darkzsaid
    mostrar_resumen
}

main "$@"
